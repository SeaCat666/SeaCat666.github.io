-
  const cdnConfig = theme.CDN || {}
  const internal_provider = cdnConfig.internal_provider || 'local'
  const third_party_provider = cdnConfig.third_party_provider || 'local'
  const custom_format = cdnConfig.custom_format
  const providers = {
    'jsdelivr': '//cdn.jsdelivr.net',
    'cdnjs': '//cdnjs.cloudflare.com',
    'unpkg': '//unpkg.com',
    'custom': custom_format && custom_format.match(/^((https?:)?(\/\/[^/]+)|([^/]+))(\/|$)/)[1]
  }
  const internalProviderUrl = providers[internal_provider]
  const thirdPartyProviderUrl = providers[third_party_provider]
-

if internal_provider === third_party_provider && internalProviderUrl
  link(rel="preconnect" href=internalProviderUrl)
else
  if internalProviderUrl
    link(rel="preconnect" href=internalProviderUrl)
  if thirdPartyProviderUrl
    link(rel="preconnect" href=thirdPartyProviderUrl)

if theme.google_analytics
  link(rel="preconnect" href="//www.google-analytics.com" crossorigin='')

if theme.baidu_analytics
  link(rel="preconnect" href="//hm.baidu.com")

if theme.cloudflare_analytics
  link(rel="preconnect" href="//static.cloudflareinsights.com")

if theme.microsoft_clarity
  link(rel="preconnect" href="//www.clarity.ms")

if theme.blog_title_font && theme.blog_title_font.font_link && theme.blog_title_font.font_link.indexOf('//fonts.googleapis.com') != -1
  link(rel="preconnect" href="//fonts.googleapis.com" crossorigin='')

if !theme.asset.busuanzi && (theme.busuanzi.site_uv || theme.busuanzi.site_pv || theme.busuanzi.page_pv)
  link(rel="preconnect" href="//busuanzi.ibruce.info")
